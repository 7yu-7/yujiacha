# ============================================================================
# 渔价查 · 环境变量（复制为 .env 并按实际情况填写）
# 注意：本文件 .env 不入库、不提交（见 .gitignore）
# ============================================================================

# ── 服务 ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
CORS_ORIGINS=*

# ── 数据库 ──────────────────────────────────────────────────────────────────
# 驱动：mysql（默认，对接自动化采集系统的 fish_price 库）| sqlite（无密码回退）
DB_DRIVER=mysql

# MySQL（PRD 指定：本机 MySQL，库名 fish_price，root@localhost:3306）
# ⚠️ 生产环境务必改为专用账号，不要使用 root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fish_price
DB_POOL=10

# SQLite（DB_DRIVER=sqlite 时生效）
# SQLITE_FILE=./data/fish_price.db

# ── 账户与令牌（生产必须改）────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000

# ── 邮件（邮箱验证 / 忘记密码）──────────────────────────────────────────────
# 开发环境不配置 SMTP 时，邮件落到 data/mail/ 站内取件箱，并提供接口读取，便于联调
MAIL_FROM=noreply@yujiacha.local
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# ── 缓存与演示数据 ──────────────────────────────────────────────────────────
CACHE_TTL=60
# 不设置 = 22 个月完整历史（669 天）；设置则按天数生成
# DEMO_HISTORY_DAYS=90
