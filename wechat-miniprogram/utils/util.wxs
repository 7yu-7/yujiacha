// 鱼价查 · WXS 格式化（WXML 中可用 u.fmtPrice(...) 等）
// 注意：WXS 语法受限，不使用 isNaN/Number 等全局转换
var fmtPrice = function (v, d) {
  if (v == null || v === '') return '-';
  if (d == null) d = 2;
  var n = v * 1;
  return n.toFixed(d);
};
var fmtPct = function (v) {
  if (v == null) return '-';
  var n = v * 1;
  var s = n > 0 ? '+' : '';
  return s + n.toFixed(2) + '%';
};
var clsPct = function (v) {
  if (v == null || v == 0) return 'flat';
  if (v > 0) return 'up';
  return 'down';
};
var fmtDate = function (d) {
  if (!d) return '';
  return d.substring(0, 10);
};
module.exports = {
  fmtPrice: fmtPrice,
  fmtPct: fmtPct,
  clsPct: clsPct,
  fmtDate: fmtDate
};
