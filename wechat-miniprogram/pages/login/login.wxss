.seg {
  display: flex;
  margin: 24rpx 20rpx 8rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 34rpx;
  font-size: 28rpx;
  color: #555;
}
.seg-item.on {
  background: #005F73;
  color: #fff;
  font-weight: 600;
}
.field {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #f0f2f4;
}
.field .label {
  width: 110rpx;
  color: #444;
  font-size: 28rpx;
}
.field .input {
  flex: 1;
  font-size: 28rpx;
}
