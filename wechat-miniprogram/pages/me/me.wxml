<view class="brand-bar">
  <view class="title">我的</view>
</view>

<view class="card row between" bindtap="{{user ? '' : 'goLogin'}}">
  <view wx:if="{{user}}">
    <view class="name">{{user.nickname || user.email}}</view>
    <view class="tiny muted">{{user.email}}</view>
  </view>
  <view wx:else>
    <view class="name">未登录</view>
    <view class="tiny muted">点击登录，云端同步关注与提醒</view>
  </view>
  <text class="muted" wx:if="{{!user}}">›</text>
</view>

<view class="card">
  <view class="li" bindtap="goWatch">
    <text class="name">我的关注</text>
    <text class="muted">›</text>
  </view>
  <view class="li">
    <text class="name">关于鱼价查</text>
    <text class="muted">全国水产品价格日报</text>
  </view>
  <view class="li">
    <text class="name">数据来源</text>
    <text class="muted">农业农村部 pfsc.agri.cn</text>
  </view>
</view>

<view wx:if="{{user}}" style="padding:20rpx">
  <view class="btn ghost" bindtap="logout">退出登录</view>
</view>
