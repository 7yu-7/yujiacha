# ============================================================================
# 渔价查 · 后端镜像
# 承载统一 REST API（服务微信小程序 / 移动 App / 管理后台 / Web-H5 四端）
# 同时托管 /web（网站）、/admin（管理后台）、/mini（小程序预览）静态资源
# ============================================================================
FROM node:22-alpine

LABEL org.opencontainers.image.title="渔价查 后端服务"
LABEL org.opencontainers.image.description="智慧渔业全国水产品价格日报系统 · 统一 REST API"
LABEL org.opencontainers.image.version="1.0.0"

# 时区对齐 UTC+8（PRD 要求时间戳为 UTC+8）
RUN apk add --no-cache tzdata curl \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && apk del tzdata

WORKDIR /app

# 依赖层（利用构建缓存）
COPY server/package*.json ./
RUN npm install --omit=dev --no-audit --no-fund

# 应用代码与静态资源
COPY server/src ./src
COPY server/sql ./sql
COPY server/scripts ./scripts
COPY shared ./shared
COPY web ./web
COPY admin ./admin
COPY client/preview ./client/preview

# 运行时数据目录（邮件取件箱 / SQLite 回退库）
RUN mkdir -p /app/data/mail /app/public \
    && chown -R node:node /app

# 以非 root 运行
USER node

ENV NODE_ENV=production \
    PORT=8787 \
    HOST=0.0.0.0

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8787/api/health || exit 1

CMD ["node", "src/server.js"]
