# ============================================================================
# 渔价查 · 管理后台镜像（静态产物 + Nginx）
# 用于将管理后台独立部署到单独域名 / 端口
# 构建参数 API_BASE：留空表示同源（由 Nginx 反代到 backend）
# ============================================================================
FROM nginx:1.25-alpine

ARG API_BASE=""
ENV API_BASE=${API_BASE}

# 复制管理后台静态资源
COPY admin /usr/share/nginx/html

# 注入 API 基址（构建期写入，运行期由前端读取 window.YJT_API_BASE）
RUN if [ -n "$API_BASE" ]; then \
      printf '<script>window.YJT_API_BASE=%s;</script>' "\"$API_BASE\"" > /usr/share/nginx/html/_api_base.html; \
    else \
      : > /usr/share/nginx/html/_api_base.html; \
    fi

# Nginx 配置：静态资源 + API 反代
RUN printf 'server {\n\
  listen 80;\n\
  server_name _;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  gzip on;\n\
  gzip_types text/css application/javascript application/json image/svg+xml;\n\
  gzip_min_length 1024;\n\
  add_header X-Frame-Options SAMEORIGIN always;\n\
  add_header X-Content-Type-Options nosniff always;\n\
  location /api/ {\n\
    proxy_pass http://backend:8787;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $scheme;\n\
    proxy_read_timeout 60s;\n\
  }\n\
  location /shared/ { proxy_pass http://backend:8787; }\n\
  location / { try_files $uri $uri/ /index.html; }\n\
  location ~* \\.(css|js|svg|png|jpg|woff2?)$ { expires 1h; add_header Cache-Control "public"; }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
