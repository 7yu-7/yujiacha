# ============================================================================
# Docker 部署环境变量（复制为 docker/.env）
# ⚠️ 生产环境必须修改 JWT_SECRET 与数据库密码
# ============================================================================
PORT=8787
ADMIN_PORT=8080
NGINX_PORT=80

# 数据库（连宿主机 MySQL 时用 host.docker.internal）
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fish_price

# 启用 --profile db（容器化 MySQL）时使用
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

# 密钥：请用 `openssl rand -hex 32` 生成
JWT_SECRET=change-me-to-a-long-random-string-in-production

APP_BASE_URL=http://localhost:8787
CORS_ORIGINS=*
CACHE_TTL=60
